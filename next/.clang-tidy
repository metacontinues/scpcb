# clang-tidy for our code (vendor/ and src/glfw.c are skipped by tools/lint.sh). bug-finding checks on, the ones that
# fight the house style off: short names, several declarations per line, unbraced if guards, ported magic numbers,
# flag bits in ints, `if ((p = strchr(..)))`, `p = realloc(p, ..)` (no oom handling anywhere), atoi on ini values,
# #pragma once, extra parens
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-signed-bitwise,
  -bugprone-suspicious-realloc-usage,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-assignment-in-if-condition,
  -bugprone-assignment-in-selection-statement,
  -bugprone-switch-missing-default-case,
  -bugprone-reserved-identifier,
  -bugprone-suspicious-string-compare,
  cert-*,
  -cert-err33-c,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err34-c,
  -cert-exp45-c,
  -cert-int09-c,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-unix.Errno,
  misc-*,
  -misc-no-recursion,
  -misc-include-cleaner,
  -misc-use-internal-linkage,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-duplicate-include,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-*,
  -readability-redundant-parentheses,
  readability-inconsistent-declaration-parameter-name,
  readability-misplaced-array-index,
WarningsAsErrors: ''
HeaderFilterRegex: '/next/(src|tools)/'
FormatStyle: file
